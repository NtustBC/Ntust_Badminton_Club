rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn() && request.auth.token.email == "admin@gmail.com";
    }

    function isAdmin() {
      return isBootstrapAdminEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOfficialMember() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/signupApprovals/$(request.auth.token.email));
    }

    function hasFormalMemberRecord() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.membershipStatus == "formal_member" ||
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "formal_member"
        );
    }

    function classSessionAllowsNonMembers(sessionId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/classSessions/$(sessionId))
        && get(/databases/$(database)/documents/classSessions/$(sessionId)).data.allowNonMembers == true;
    }
    match /admins/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /members/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(["membershipStatus", "status"]) || request.resource.data.membershipStatus in ["not_applied", "pending_payment"]) &&
        (!request.resource.data.keys().hasAny(["paymentStatus"]) || request.resource.data.paymentStatus == "unpaid")
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["membershipStatus", "status", "paymentStatus", "paidAt", "approvedAt"])
      );
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if true;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /signupApprovals/{emailId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /classSessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /classSessionSignups/{signupId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && (isAdmin() || hasFormalMemberRecord() || classSessionAllowsNonMembers(request.resource.data.sessionId))
        && (
          !request.resource.data.keys().hasAny(["dropInPaymentStatus"]) ||
          request.resource.data.dropInPaymentStatus == "unpaid" ||
          (request.resource.data.dropInPaymentStatus == "not_required" && hasFormalMemberRecord())
        );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        (hasFormalMemberRecord() || classSessionAllowsNonMembers(resource.data.sessionId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentStatus", "paidAt", "dropInPaymentStatus", "dropInPaidAt", "signupStatus"])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /classPublicRosters/{rosterId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["sessionId", "userId", "maskedName", "studentId", "createdAt", "updatedAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.maskedName is string
        && request.resource.data.maskedName.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 30
        && (isAdmin() || hasFormalMemberRecord() || classSessionAllowsNonMembers(request.resource.data.sessionId));
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.keys().hasOnly(["sessionId", "userId", "maskedName", "studentId", "createdAt", "updatedAt"])
        && request.resource.data.maskedName is string
        && request.resource.data.maskedName.size() <= 100
        && (hasFormalMemberRecord() || classSessionAllowsNonMembers(resource.data.sessionId))
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /classAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqEntries/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqQuestions/{questionId} {
      allow create: if request.resource.data.keys().hasOnly(["question", "status", "createdAt", "updatedAt"])
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 2
        && request.resource.data.question.size() <= 500
        && request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
